# Copie este arquivo para ".env" (mesma pasta) e preencha com seus valores.
# O .env NUNCA deve ser commitado no Git (veja .gitignore).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cinearquivo
DB_USER=root
DB_PASS=

APP_ENV=development
# development => mostra detalhes técnicos de erro nas respostas da API
# production  => esconde detalhes técnicos, mostra só mensagem genérica

SESSION_NAME=cinearquivo_sessao
SESSION_LIFETIME=7200

# Origens do frontend autorizadas a chamar a API (CORS), separadas por vírgula
# Só necessário se você abrir o frontend por outro servidor (ex.: Live Server na porta 5500).
# Rodando com iniciar.bat / router.php (http://127.0.0.1:8000), pode ignorar.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Pôsteres e recomendações (TMDB). Chave gratuita em themoviedb.org > Configurações > API.
# Sem a chave, o site funciona normalmente, só não busca pôsteres nem recomendações externas.
TMDB_API_KEY= 
# Só se der erro de certificado SSL no Windows/XAMPP, aponte para o bundle de certificados:
# TMDB_CA_BUNDLE=C:\xampp\apache\bin\curl-ca-bundle.crt
